{
  "name": "appium-cucumber-portfolio",
  "version": "1.0.0",
  "description": "QA automation portfolio: mobile native app + mobile web testing with Appium, WebdriverIO, Cucumber (Gherkin) and TypeScript",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:logs": "docker compose logs -f android-emulator",
    "docker:down": "docker compose down",
    "test:native": "wdio run ./config/wdio.android.native.conf.ts",
    "test:web": "wdio run ./config/wdio.android.web.conf.ts",
    "test:all": "npm run test:native && npm run test:web",
    "appium:start": "appium --allow-insecure=chromedriver_autodownload",
    "report:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "report:open": "allure open ./reports/allure-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"config/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "cucumber",
    "typescript",
    "mobile-testing",
    "qa-automation",
    "portfolio"
  ],
  "author": "Momo",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.9.0",
    "@types/node": "^22.9.0",
    "@wdio/allure-reporter": "^9.4.4",
    "@wdio/appium-service": "^9.4.4",
    "@wdio/cli": "^9.4.4",
    "@wdio/cucumber-framework": "^9.4.4",
    "@wdio/local-runner": "^9.4.4",
    "@wdio/spec-reporter": "^9.4.4",
    "@wdio/types": "^9.4.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.14.4",
    "appium-uiautomator2-driver": "^3.9.7",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
